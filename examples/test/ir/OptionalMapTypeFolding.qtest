#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/QUnit.qm
%requires ../../../qlib/FsUtil.qm
%exec-class OptionalMapTypeFoldingTest

class OptionalMapTypeFoldingTest inherits QUnit::Test {
    private {
        string qore_bin = executablePath(ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore");
        string lib_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC ?? lib_dir + "/qcc";
    }
    constructor() : Test("Optional map element type folding", "1.0", \ARGV) {
        addTestCase("Optional mapped values work in AST, IR and JIT", \modes());
        addTestCase("Optional mapped values work in source-stripped AOT", \compiled());
        addTestCase("Native map cancellation releases partial results", \cancelled());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + join("'\\''", split("'", value)) + "'";
    }
    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string directory in (split(":", ENV.PATH ?? "")) {
            string path = (directory ? directory : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", "cannot locate Qore executable " + name;
    }
    private string run(string dir, list<string> args, bool checked_append = False) {
        string command = (checked_append ? "QORE_DISABLE_IR_MAP_RESULT_FAST_APPEND=1 " : "")
            + "LD_LIBRARY_PATH=" + quote(lib_dir) + " QORE_LIBDIR=" + quote(lib_dir)
            + " " + (map quote($1), args).join(" ");
        string log = dir + "/run.log";
        int status = system(command + " > " + quote(log) + " 2>&1");
        string output = File::readTextFile(log);
        assertEq(0, status, output);
        assertFalse(output.regex("(?i)warning:"), output);
        return output;
    }
    private string fixture(string dir) {
        string source = dir + "/optional-map.qr";
        File f();
        f.open2(source, O_CREAT | O_TRUNC | O_WRONLY);
        on_exit f.close();
        f.write(File::readTextFile(get_script_dir() + "/OptionalMapTypeFolding.qr"));
        return source;
    }
    private modes() {
        TmpDir dir("qore-optional-map-types-");
        string source = fixture(dir.path);
        foreach string mode in ("ast", "ir", "jit") {
            assertEq("optional-map-type-folding: ok\n",
                run(dir.path, (qore_bin, "-b", "--enable-debug", "--exec-mode=" + mode, source)));
        }
        assertEq("optional-map-type-folding: ok\n",
            run(dir.path, (qore_bin, "-b", "--enable-debug", "--exec-mode=jit", source), True));
    }
    private compiled() {
        TmpDir dir("qore-optional-map-aot-");
        string source = fixture(dir.path);
        string executable = dir.path + "/optional-map";
        run(dir.path, (qcc_bin, "-O3", "--strip-source", "-o", executable, source));
        assertEq("optional-map-type-folding: ok\n", run(dir.path, (executable,)));
        assertEq("optional-map-type-folding: ok\n", run(dir.path, (executable,), True));
    }
    private cancelled() {
        TmpDir dir("qore-map-cancel-");
        string root = get_script_dir() + "/../../..";
        string executable = dir.path + "/map-cancel";
        run(dir.path, (ENV.CXX ?? "c++", "-std=c++17", "-g", "-I" + root + "/include",
            "-I" + lib_dir + "/include", get_script_dir() + "/optional_map_cancellation.cpp",
            "-L" + lib_dir, "-lqore", "-o", executable));
        assertEq("optional-map-cancellation: ok\n", run(dir.path, (executable,)));
        assertEq("optional-map-cancellation: ok\n", run(dir.path, (executable,), True));
    }
}
