#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern

HTTPClient client({"url": ARGV[0], "timeout": 20s, "connect_timeout": 20s,
    "pre_encoded_urls": ARGV[1] == "constructor"});
if (ARGV[1] == "setter") {
    @assert(!client.setPreEncodedUrls());
}
@assert(client.getPreEncodedUrls());
for (int index = 2; index < ARGV.size(); ++index) {
    try {
        @assert(client.get(ARGV[index]) == "OK");
        printf("OK\n");
    } catch (hash<ExceptionInfo> ex) {
        printf("ERROR:%s\n", ex.err);
    }
}
