#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/DataProvider
%exec-class SoftListMissingValuesTest

class CheckedSoftListItem inherits QoreDataType {
    public {
        int calls;
    }
    constructor() : QoreDataType(IntType) {
    }
    auto acceptsValue(auto value) {
        ++calls;
        if (!exists value) {
            throw "ITEM-MISSING", "an integer item must be supplied";
        }
        if (value.typeCode() != NT_INT || value < 0) {
            throw "ITEM-VALUE", "a nonnegative integer item must be supplied";
        }
        return value;
    }
}

class SoftListMissingValuesTest inherits QUnit::Test {
    constructor() : Test("Missing optional soft lists", "1.0") {
        addTestCase("Absent lists do not invoke item validation", \optional());
        addTestCase("Optional list items remain explicit occurrences", \items());
        addTestCase("Mandatory copies retain item validation", \mandatory());
        addTestCase("Missing collection defaults are validated as collections", \defaults());
        addTestCase("Record fields distinguish missing lists from invalid items", \records());
        set_return_value(main());
    }
    optional() {
        CheckedSoftListItem item();
        foreach AbstractDataProviderType type in (new SoftListDataType(item, True),
                new SoftListDataType("numbers", item, True), new SoftListDataType(item).getOrNothingType(),
                new SoftListDataType(IntType, True), new SoftListDataType("numbers", IntType, True),
                new SoftListDataType(IntType).getOrNothingType()) {
            foreach AbstractDataProviderType copy in (type, Serializable::deserialize(type.serialize())) {
                assertFalse(copy.isMandatory());
                assertEq(NOTHING, copy.acceptsValue(NOTHING));
                assertEq((), copy.acceptsValue(()));
                assertEq((0,), copy.acceptsValue(0));
                assertEq((0, 2), copy.acceptsValue((0, 2)));
            }
        }
        int calls = item.calls;
        SoftListDataType optional(item, True);
        assertEq(NOTHING, optional.acceptsValue(NOTHING));
        assertEq(calls, item.calls);
        assertThrows("ITEM-VALUE", \optional.acceptsValue(), ((-1,),));
        assertEq((3,), optional.acceptsValue(3));
    }
    items() {
        SoftListDataType type(AbstractDataProviderType::get("*int"), True);
        list<auto> occurrences = (NOTHING, 0, NOTHING);
        assertEq(NOTHING, type.acceptsValue(NOTHING));
        assertEq(occurrences, type.acceptsValue(occurrences));
        assertEq(3, type.acceptsValue(occurrences).size());
        SoftListDataType nulls(AbstractDataProviderType::get("null"), True);
        assertEq((NULL,), nulls.acceptsValue(NULL));
        assertEq(NOTHING, nulls.acceptsValue(NOTHING));
    }
    mandatory() {
        CheckedSoftListItem item();
        SoftListDataType optional(item, True);
        foreach AbstractDataProviderType type in (new SoftListDataType(item), optional.getMandatoryType()) {
            foreach AbstractDataProviderType copy in (type, Serializable::deserialize(type.serialize())) {
                assertTrue(copy.isMandatory());
                assertThrows("ITEM-MISSING", \copy.acceptsValue(), (NOTHING,));
                assertThrows("ITEM-MISSING", \copy.acceptsValue(), ((NOTHING,),));
                assertThrows("ITEM-VALUE", \copy.acceptsValue(), (NULL,));
                assertEq((4,), copy.acceptsValue(4));
            }
        }
        assertFalse(optional.isMandatory());
        assertEq(NOTHING, optional.acceptsValue(NOTHING));
    }
    defaults() {
        CheckedSoftListItem item();
        foreach bool optional in (False, True) {
            SoftListDataType original(item, optional, NOTHING, NOTHING, (2, 3));
            foreach AbstractDataProviderType type in (original, Serializable::deserialize(original.serialize())) {
                assertEq((2, 3), type.acceptsValue(NOTHING));
                list<auto> changed = type.acceptsValue(NOTHING);
                changed[0] = 99;
                assertEq((2, 3), type.acceptsValue(NOTHING));
                assertEq((), type.acceptsValue(()));
                assertEq((0,), type.acceptsValue(0));
                assertThrows("ITEM-VALUE", \type.acceptsValue(), (NULL,));
            }
            SoftListDataType invalid(item, optional, NOTHING, NOTHING, (-1,));
            assertThrows("ITEM-VALUE", \invalid.acceptsValue(), (NOTHING,));
            assertEq((5,), invalid.acceptsValue(5));
            SoftListDataType empty(item, optional, NOTHING, NOTHING, ());
            assertEq((), empty.acceptsValue(NOTHING));
        }
    }
    records() {
        CheckedSoftListItem item();
        HashDataType record("batch");
        record.addField(new QoreDataField({"name": "numbers", "type": new SoftListDataType(item, True)}));
        foreach AbstractDataProviderType type in (record, Serializable::deserialize(record.serialize())) {
            assertEq(NOTHING, type.acceptsValue({}).numbers);
            assertEq(NOTHING, type.acceptsValue({"numbers": NOTHING}).numbers);
            assertEq((1, 2), type.acceptsValue({"numbers": (1, 2)}).numbers);
            assertThrows("RUNTIME-TYPE-ERROR", "ITEM-MISSING", \type.acceptsValue(), ({"numbers": (NOTHING,)},));
            assertThrows("RUNTIME-TYPE-ERROR", "ITEM-VALUE", \type.acceptsValue(), ({"numbers": (-1,)},));
            assertEq((0,), type.acceptsValue({"numbers": 0}).numbers);
        }
    }
}
