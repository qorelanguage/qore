#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/RestSchemaDataProvider
%requires json
%exec-class ResponseValuesTest

class ResponseValueClient inherits RestClientIo::RestClientIo {
    public {
        auto response;
    }
    constructor() : RestClientIo({"url": "https://example.org"}) {
    }
    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> headers) {
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response, "headers": {"x-test": "yes"}};
    }
}

class ResponseValuesTest inherits QUnit::Test {
    constructor() : Test("REST schema response values", "1.0", \ARGV) {
        addTestCase("empty and false values remain present", \valuesTest());
        set_return_value(main());
    }
    private valuesTest() {
        ResponseValueClient client();
        RestSchemaDataProvider meta({"schema": make_json({
            "openapi": "3.1.0", "info": {"title": "Responses", "version": "1"},
            "paths": {"/value": {"get": {"responses": {"200": {
                "description": "Result", "content": {"application/json": {"schema": {}}},
            }}}}},
        })});
        RestSchemaDataProvider root(meta.getSchema(), client);
        AbstractDataProvider provider = root.getChildProviderPath("value/GET");
        foreach auto value in ({}, (), False, 0, "", binary(), {"ok": True}) {
            client.response = value;
            hash<auto> result = provider.doRequest({}, {"include_response_headers": True});
            assertTrue(exists result.body);
            assertEq(value, result.body);
            assertEq(value.typeCode(), result.body.typeCode());
            assertEq("yes", result.headers."x-test");
        }
        client.response = NOTHING;
        hash<auto> result = provider.doRequest({}, {"include_response_headers": True});
        assertFalse(exists result.body);
        assertEq("yes", result.headers."x-test");
    }
}
