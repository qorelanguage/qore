-----END PRIVATE KEY-----";
    }

    constructor() : Test("WebSocketSlowHandlerTest", "1.0") {
        # must run before anything dispatches a callback: the worker cap is read when
        # the dispatcher is constructed
        getGlobalAsyncIoController().setMaxCallbackWorkers(Workers);

        addTestCase("a slow WS handler neither starves the pool nor loses frames",
            \testSlowHandlerDoesNotStarvePool());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("ws-slow-handler-test", m_options.verbose > 2
            ? LoggerLevel::getLevelInfo()
            : LoggerLevel::getLevelWarn());
        mLogger.addAppender(new StdoutAppender());

        mWsHandler = new SlowWsHandler({"logger": mLogger});
        mServer = new HttpServer(<HttpServerOptionInfo>{"logger": mLogger, "debug": True});
        mServer.setHandler("ws-handler", "/ws", NOTHING, mWsHandler);
        mPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mWsUrl = "wss://localhost:" + mPort + "/ws";
        mServer.waitForAsyncIo();
        if (m_options.verbose > 1) {
            printf("WS/H2 slow-handler test server on port %d\n", mPort);
        }
    }

    globalTearDown() {
        delete mServer;
    }

    testSlowHandlerDoesNotStarvePool() {
        ws_hold = new Counter(1);
        ws_holding = new Counter(1);
        ws_handled = new Counter(BusyMessages + 1);
        ws_recv_lock = new Mutex();
        ws_messages = ();

        WebSocketClient wsc(sub (*data msg) {}, {
            "url": mWsUrl,
            "logger": mLogger,
            "http_version": "2.0",
            "ssl_verify_cert": False,
            "timeout": 30000,
        });
        on_exit {
            # never leave the handler parked, even on a failed assertion
            if (ws_hold.getCount()) {
                ws_hold.dec();
            }
            delete wsc;
        }

        wsc.connect();

        # park the handler inside gotMessage()
        list<string> expected = ("hold",);
        wsc.send("hold");
        assertEq(0, ws_holding.waitForZero(HangTimeout), "the WS handler never started");

        # keep the peer sending while user code runs: every one of these produces a
        # stream-data notification on a dispatcher callback worker
        for (int i = 0; i < BusyMessages; ++i) {
            string msg = sprintf("busy-%03d", i);
            expected += msg;
            wsc.send(msg);
        }
        usleep(Settle);

        # the pool must still be able to run an unrelated callback: notifications for a
        # busy connection are skipped, not parked on the connection's process mutex
        Counter probe(1);
        getGlobalAsyncIoController().addTimer(now_us(), sub () {
            probe.dec();
        });
        assertEq(0, probe.waitForZero(HangTimeout),
            "a slow WebSocket handler parked the whole async I/O callback worker pool");

        # release the handler: every skipped notification must still be delivered, in order
        ws_hold.dec();
        assertEq(0, ws_handled.waitForZero(HangTimeout),
            "frames that arrived while the handler was busy were never delivered");
        assertEq(expected, ws_messages,
            "every frame sent during the slow handler was delivered exactly once, in order");
    }
}
