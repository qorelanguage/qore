%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) UnstructuredRestClient
%requires RestClientIo

module UnstructuredDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Unstructured.io services";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new UnstructuredDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": UnstructuredDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Unstructured.io",
            "short_desc": "Unstructured.io document partitioning (element-tree extraction)",
            "desc": "Provides access to [Unstructured.io](https://unstructured.io) — "
                "a document partitioning service that breaks PDFs, docx, HTML, and "
                "images into a typed element tree (Title / NarrativeText / ListItem "
                "/ Table / ...).\n\n"
                "Use the @ref QoreRagUtils::UnstructuredChunker \"UnstructuredChunker\" "
                "backend for the RAG ingestion path through "
                "@ref QoreRagUtils::RagPipeline \"RagPipeline\".",
            "scheme": "unstructured",
            "logo": UnstructuredLogo,
            "logo_file_name": "unstructured-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::AiLlm, DataProvider::AppGroup::Documents,),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": UnstructuredDataProvider::AppName,
            "path": "/partition-file",
            "action": "partition-file",
            "display_name": "Partition Document",
            "short_desc": "Partition a document file into a typed element tree",
            "desc": "Submits a document to [Unstructured.io](https://unstructured.io) and "
                "returns it as a list of typed elements — `Title`, `NarrativeText`, "
                "`ListItem`, `Table`, `Image` and so on — each with its own metadata.\n\n"
                "This is the action to use for **PDFs, Office documents, images, emails** "
                "and every other format Unstructured supports; use `partition-text` for "
                "content already held as text.\n\n"
                "**Typical uses**:\n"
                "- Turning a document archive into records a RAG pipeline can index, with "
                "`chunking_strategy` producing retrieval-sized chunks directly\n"
                "- Pulling tables out of reports as HTML with `pdf_infer_table_structure`\n"
                "- Reading scans and photographs with the `ocr_only` or `hi_res` strategies\n\n"
                "Give the document either inline as `file_data` or by `file_path`.",
            "action_code": DPAT_API,
            "groups": ("Document Extraction",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                UnstructuredPartitionFileRequestDataType::Fields{
                    "file_data", "file_path", "filename",
                }, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                UnstructuredPartitionFileRequestDataType::Fields - (
                    "file_data", "file_path", "filename",
                )
            ),
            "output_type": UnstructuredPartitionFileDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": UnstructuredDataProvider::AppName,
            "path": "/partition-text",
            "action": "partition-text",
            "display_name": "Partition Text",
            "short_desc": "Partition raw text into a typed element tree",
            "desc": "Submits text to [Unstructured.io](https://unstructured.io) and returns it "
                "as a list of typed elements — `Title`, `NarrativeText`, `ListItem`, `Table` "
                "and so on — each with its own metadata.\n\n"
                "Use this when the content is already text; for **PDFs, Office documents, "
                "images and emails** use `partition-file`.\n\n"
                "**Note**: set `content_type` when the text carries structure, or the "
                "markup is not parsed — HTML submitted as `text/plain` comes back as a single "
                "element holding the raw markup, and Markdown keeps its `#` and `-` markers "
                "in the element text.",
            "action_code": DPAT_API,
            "groups": ("Document Extraction",),
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                UnstructuredPartitionTextRequestDataType::Fields{"text",}, {
                    "preselected": True, "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                UnstructuredPartitionTextRequestDataType::Fields - ("text",)
            ),
            "output_type": UnstructuredPartitionTextDataProvider::ResponseType,
        });
    };
}

/** @mainpage UnstructuredDataProvider Module

    @tableofcontents

    @section unstructureddataproviderintro UnstructuredDataProvider Introduction

    Data-provider integration for
    [Unstructured.io](https://unstructured.io), which breaks a document into
    a typed element tree suitable for RAG ingestion.

    Two `DPAT_API` actions post to Unstructured's `/general/v0/general`
    endpoint:

    - `partition-file` — for PDFs, Office documents, images, emails and every
      other format Unstructured supports; the document is given either inline
      or by local path
    - `partition-text` — for content already held as text; set `content_type`
      when that text carries structure, or its markup is not parsed

    Both accept the endpoint's full option set: partitioning strategy, OCR
    languages, table-structure inference, image-block extraction, and
    server-side chunking with its size, overlap and similarity controls.

    For RAG-pipeline integration, prefer the
    @ref QoreRagUtils::UnstructuredChunker "UnstructuredChunker" backend
    (lazy-loaded via the @c "unstructured" chunker strategy).

    @section UnstructuredDataProviderRelnotes Release Notes

    @subsection UnstructuredDataProviderv1_0 UnstructuredDataProvider v1.0
    - the initial version of the %UnstructuredDataProvider module
*/

#! contains all public definitions in the UnstructuredDataProvider module
public namespace UnstructuredDataProvider {
#! Unstructured.io application name
public const AppName = "UnstructuredIo";
}

#! App logo loaded from file
public const UnstructuredLogo = File::readTextFile(get_script_dir() + "/unstructured-logo.svg");
