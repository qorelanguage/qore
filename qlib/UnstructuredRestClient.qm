%requires qore >= 2.0
%modern

%requires(reexport) Mime >= 1.3
%requires(reexport) RestClient >= 1.3.1
%requires(reexport) RestClientIo
%requires(reexport) ConnectionProvider >= 1.4
%requires QoreRagTypes

module UnstructuredRestClient {
    version = "1.0";
    desc = "user module for calling Unstructured.io document-partitioning REST services";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("unstructured",
            UnstructuredRestConnection::ConnectionScheme);
        QoreRagUtils::RagProviderRegistry::registerChunkerFactory(
            new UnstructuredChunkerFactory());
    };
}

/** @mainpage UnstructuredRestClient Module

    @tableofcontents

    @section unstructuredrestclientintro UnstructuredRestClient Introduction

    The %UnstructuredRestClient module provides a REST client for
    [Unstructured.io](https://unstructured.io) — a document partitioning
    service that breaks PDFs, docx, HTML, images, and other formats into
    a typed element tree (Title, NarrativeText, ListItem, Table, Image,
    ...) suitable for RAG ingestion.

    Works against both the Unstructured Serverless API and self-hosted
    Unstructured deployments — same module, different URL.

    @par Choosing the URL

    An Unstructured API key is issued for exactly one deployment and is
    rejected with a `401` by all the others, and no Unstructured API
    reports which deployment a key belongs to.  A key sent to the wrong
    deployment is reported as `API key is invalid` and one of the wrong
    shape entirely as `API key is malformed`, so an authentication error
    here usually means the URL is wrong rather than the key.

    The default is `https://api.transform.unstructured.io`, Unstructured's
    current deployment.  A connection does not have to be configured for
    an account on the older `https://api.unstructuredapp.io` deployment:
    @ref UnstructuredRestClient::UnstructuredRestConnection "UnstructuredRestConnection"
    tries the alternatives when the configured deployment rejects the key
    and moves itself to whichever one accepts it — see
    @ref UnstructuredRestClient::UnstructuredRestConnection::KnownApiUrls "KnownApiUrls".
    Self-hosted deployments are configured by URL as usual and are never
    moved, as there is nowhere else to try.

    Note also that the Unstructured **Platform API** (workflows, sources,
    destinations and jobs) is a different service with its own host and
    no partition endpoint; this module implements the partition API only,
    so a Platform API base URL will not work here.

    @par Submission shapes

    The v1 client supports two submission shapes via the
    `/general` endpoint:

    - `partitionFile(filename, content_type, body)` — multipart upload
      of arbitrary binary content (PDF, docx, etc.)
    - `partitionText(text, *options)` — synthesizes a `text/plain`
      multipart upload from a string (useful when the caller has
      already extracted text from elsewhere)

    Both delegate to the same low-level
    @ref UnstructuredRestClient::UnstructuredRestClientIo::partition()
    multipart helper.

    @par Companion chunker

    @ref QoreRagUtils::UnstructuredChunker (lazy-loaded via the
    @c "unstructured" chunker strategy) wraps `partitionText()` and
    collapses the returned element tree into flat `ChunkInfo` records.

    @section UnstructuredRestClientRelnotes Release Notes

    @subsection UnstructuredRestClientv1_0 UnstructuredRestClient v1.0
    - the initial version of the %UnstructuredRestClient module
*/

%requires json

public namespace UnstructuredRestClient {
public class UnstructuredRestClientBase {
    public {
        #! Default Unstructured partition API URL
        /** Unstructured's current deployment; accounts issued a key for the older
            \c "https://api.unstructuredapp.io" deployment must set the URL explicitly, which
            @ref UnstructuredRestClient::UnstructuredRestConnection "UnstructuredRestConnection"
            does for them on the first ping
        */
        const DefaultUrl = "https://api.transform.unstructured.io";

        const DefaultOptions = {
            "url": DefaultUrl,
        };
    }

    #! Unstructured uses the `unstructured-api-key` header
    static hash<auto> getOptions(hash<auto> opts) {
        hash<auto!> rv;
        rv += DefaultOptions + opts;
        if (rv.apikey) {
            hash<auto!> dh;
            if (rv.headers) {
                dh += rv.headers;
            }
            dh."unstructured-api-key" = rv.apikey;
            rv.headers = dh;
            delete rv.apikey;
        }
        return rv;
    }
}

#! REST client for Unstructured.io (sync)
public class UnstructuredRestClient inherits RestClient::RestClient, UnstructuredRestClientBase {
    constructor(hash<auto> opts, *softbool do_not_connect)
            : RestClient(UnstructuredRestClientBase::getOptions(opts), True) {
    }
}

#! REST client for Unstructured.io using multiplexed HTTP connections (async)
/** Provides `partition()` (multipart-aware), `partitionFile()`, and
    `partitionText()` helpers that wrap the
    `POST /general/v0/general` endpoint.
*/
public class UnstructuredRestClientIo inherits RestClientIo::RestClientIo, UnstructuredRestClientBase {
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager shared_mgr)
            : RestClientIo(UnstructuredRestClientBase::getOptions(opts), shared_mgr) {
    }

    #! Partitions a document already present in memory
    /** @param filename the filename to send in the multipart Content-Disposition
        @param content_type the content type of the file
        @param body the file content (binary or string)
        @param options optional Unstructured fields (e.g. \c strategy:
            \c "fast" / \c "hi_res" / \c "ocr_only" / \c "auto";
            \c chunking_strategy: \c "by_title" / \c "basic";
            \c languages, \c coordinates, \c output_format)

        @return list of element hashes (Title, NarrativeText, ListItem, etc.)
    */
    list<hash<auto>> partition(string filename, string content_type, data body,
            *hash<auto> options) {
        Mime::MultiPartFormDataMessage msg();
        msg.addPart(body, "files", filename, content_type);
        if (options) {
            foreach hash<auto> p in (options.pairIterator()) {
                if (p.value.typeCode() == NT_LIST) {
                    # repeated fields (e.g. languages); addPart() rejects a repeated name
                    foreach auto v in (p.value) {
                        msg.addRepeatedPart(v.toString(), p.key);
                    }
                } else {
                    msg.addPart(p.value.toString(), p.key);
                }
            }
        }
        hash<MessageInfo> mi = msg.getMsgAndHeaders();
        # NOTE the multipart body is already serialized, so it must be sent with
        # restDoRawRequest(); restPost() would hand it to the client's data serializer, which
        # base64-encodes a binary body into a quoted JSON/YAML string and destroys the message
        hash<auto> resp = restDoRawRequest("POST", "/general/v0/general", mi.body, mi.hdr);
        # Unstructured returns the elt_list directly as the body (a list of hashes)
        if (resp.body.typeCode() == NT_LIST) {
            return cast<list<hash<auto>>>(resp.body);
        }
        # Some Unstructured deployments wrap in {elt_list: [...]}
        if (resp.body.elt_list && resp.body.elt_list.typeCode() == NT_LIST) {
            return cast<list<hash<auto>>>(resp.body.elt_list);
        }
        throw "UNSTRUCTURED-ERROR",
            sprintf("unexpected /general response shape: %y", resp.body),
            {"body": resp.body};
    }

    #! Partitions raw text by synthesizing a text/plain multipart upload
    /** @param text the document text to partition
        @param options optional Unstructured fields

        @return list of element hashes
    */
    list<hash<auto>> partitionText(string text, *hash<auto> options) {
        return partition("input.txt", "text/plain", text, options);
    }

    #! Partitions a file on disk (reads the file, then calls @ref partition())
    /** @param path local file path
        @param content_type the content type of the file
        @param options optional Unstructured fields

        @return list of element hashes
    */
    list<hash<auto>> partitionFile(string path, string content_type,
            *hash<auto> options) {
        binary body = File::readBinaryFile(path);
        # Extract just the basename for the multipart filename
        string filename = path;
        filename =~ s/^.*\///;
        return partition(filename, content_type, body, options);
    }
}

#! Class for Unstructured.io REST connections
public class UnstructuredRestConnection inherits RestClient::RestConnection {
    public {
        #! The default connection URL
        const DefaultUrl = "unstructured://api.transform.unstructured.io";

        #! Every known public Unstructured partition API deployment, in probe order
        /** An API key is issued for exactly one deployment and is rejected with a \c 401 by all
            the others, and no Unstructured API reports which deployment a key belongs to, so the
            only way to identify it is to try each one; @ref pingImpl() does that when the
            configured deployment rejects the key.

            Self-hosted deployments are not listed here: their URLs are unknowable, and a
            self-hosted connection that fails to authenticate has nowhere else to be tried.
        */
        const KnownApiUrls = (
            DefaultUrl,
            "unstructured://api.unstructuredapp.io",
        );

        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Unstructured.io Document Partitioning Connection",
            "short_desc": "A connection to the Unstructured.io REST API",
            "desc": "A connection to [Unstructured.io](https://unstructured.io) — a "
                "document partitioning service that breaks PDFs, docx, HTML, and "
                "images into a typed element tree.\n\n"
                "Works against Unstructured's hosted deployments and self-hosted "
                "deployments — same module, different URL.  An API key is issued for one "
                "deployment and is rejected by the others; when the configured deployment "
                "rejects the key, the connection tries the other known deployments on the "
                "next ping and moves itself to whichever one accepts it.\n\n"
                "Auth: the `unstructured-api-key` header.",
            "cls": Class::forName("UnstructuredRestConnection"),
            "auto_url": True,
            "schemes": {"unstructured": True},
            "base_scheme_map": {"http": "unstructured", "https": "unstructured"},
            "options": RestConnection::ConnectionScheme.options + {
                "apikey": <ConnectionOptionInfo>{
                    "display_name": "API Key",
                    "short_desc": "Unstructured.io API key",
                    "type": "string",
                    "desc": "The Unstructured.io API key — sent as the "
                        "`unstructured-api-key` header.",
                    "sensitive": True,
                    "preselected": True,
                },
            },
            "required_options": "apikey",
        };

        #! Filename sent for the empty document submitted by the default ping
        const PingFilename = "ping.txt";
    }

    constructor(string name, string description, string url = DefaultUrl,
            hash<auto> attributes = {}, hash<auto> options = {})
            : RestConnection(name, description, url, attributes, options) {
    }

    constructor(hash<auto> config, *hash<auto> attr)
            : RestConnection(config + (exists config.url ? {} : {"url": DefaultUrl}), attr) {
    }

    string getType() {
        return "unstructured";
    }

    bool hasDataProvider() {
        return True;
    }

    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        load_module("UnstructuredDataProvider");
        return create_object("UnstructuredDataProvider", getAsync());
    }

    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Declares that this connection can update its own options
    /** @ref pingImpl() moves the connection to the deployment that accepts its API key, and the
        corrected URL has to be persisted for that to be worth anything.  The base class declares
        the feature only for OAuth2 and custom-token connections, whose options change on their own.
    */
    private setFeatures() {
        RestConnection::setFeatures();
        features{CF_UPDATE_OPTIONS} = True;
    }

    #! Pings the server by submitting an empty document to the partition endpoint
    /** Unstructured's partition API exposes no authenticated \c GET endpoint: \c "GET healthcheck"
        is served without credentials, so pinging it reports success even when the API key is
        invalid or missing.  Posting a \c files part with no content instead returns an empty
        element list when the key is valid and \c 401 when it is not, so the credentials are
        actually verified; no document content is submitted, so no partitioning work is done.

        When the configured deployment rejects the key, the other deployments in
        @ref KnownApiUrls are tried, and the connection moves to whichever one accepts it; see
        @ref adoptWorkingApiUrl().

        Set both the \c ping_method and \c ping_path options to use the standard
        @ref RestClient::RestConnection "RestConnection" ping instead — for a self-hosted
        deployment that rejects an empty upload, \c "GET" and \c "healthcheck" restore a plain
        liveness check.  Note that such a ping cannot detect an invalid API key.

        @throw REST-RESPONSE-ERROR the server rejected the ping request
    */
    private pingImpl() {
        if (opts.ping_method && opts.ping_path) {
            RestConnection::pingImpl();
            return;
        }
        UnstructuredRestClientIo client = cast<UnstructuredRestClientIo>(getAsync());
        try {
            UnstructuredRestConnection::pingApi(client);
        } catch (hash<ExceptionInfo> ex) {
            # anything other than the server rejecting the key is a real failure of this ping
            if (!UnstructuredRestConnection::isApiKeyRejection(ex) || !adoptWorkingApiUrl(client)) {
                authFailure();
                rethrow;
            }
        }
        authSuccess();
    }

    #! Returns the deployments to try when the configured one rejects the API key
    /** @return @ref KnownApiUrls; override to give a private or self-hosted deployment its own
        set of alternatives, or to return nothing to disable the search entirely
    */
    private *softlist<string> getKnownApiUrls() {
        return KnownApiUrls;
    }

    #! Submits an empty document to verify that the server accepts the API key
    /** @param client the client to submit with

        @throw REST-RESPONSE-ERROR the server rejected the request
    */
    private static pingApi(UnstructuredRestClientIo client) {
        client.partition(PingFilename, MimeTypeText, "");
    }

    #! Returns @ref True if the exception is the server rejecting the API key
    /** Unstructured answers a key that belongs to another deployment, and one that is malformed,
        with the same \c 401; neither can be told from the other, and both mean "not this
        deployment's key".

        @param ex the exception thrown by the failed request

        @return @ref True if the server rejected the API key
    */
    private static bool isApiKeyRejection(hash<ExceptionInfo> ex) {
        return ex.err == "REST-RESPONSE-ERROR"
            && (ex.arg.status_code == 401 || ex.arg.status_code == 403);
    }

    #! Moves the connection to the known deployment that accepts its API key
    /** An Unstructured API key is issued for one deployment and rejected by the others, and
        nothing in any Unstructured API says which one a key belongs to, so a connection pointed at
        the wrong deployment can only be identified by trying the alternatives.  Leaving it pointed
        at the wrong one is the worse outcome: every request fails with an authentication error
        that reads as a bad key rather than a bad URL, which is exactly the wrong thing to go
        looking at.

        The choice is made on the fixed order of @ref KnownApiUrls so that a working connection
        cannot move merely because one deployment answered more slowly, and the rejections are
        logged so that the choice can be seen.

        @param client the client whose credentials are to be tried against the other deployments

        @return @ref True if another deployment accepted the key and the connection was moved
    */
    private bool adoptWorkingApiUrl(UnstructuredRestClientIo client) {
        list<string> rejected = ();
        foreach string candidate in (getKnownApiUrls()) {
            string candidate_url = AbstractConnection::getRealUrl(candidate,
                getConnectionSchemeInfo(), getType());
            if (candidate_url == real_url) {
                continue;
            }
            try {
                UnstructuredRestConnection::pingApi(
                    cast<UnstructuredRestClientIo>(client.copyWithUrl(candidate_url)));
            } catch (hash<ExceptionInfo> ex) {
                # an unreachable or broken deployment must not stop the remaining ones being tried
                rejected += sprintf("%s (%s)", candidate_url, ex.err);
                continue;
            }
            info("connection %y: the API key is not accepted by %y but is accepted by %y; moving "
                "the connection there%s", name, real_url, candidate_url,
                rejected ? sprintf("; also rejected by: %y", rejected) : "");
            # correct this object as well as the stored connection, so that clients created before
            # the platform reloads the connection already target the right deployment
            setRealUrl(candidate);
            doUpdateOptions(self, {"url": candidate});
            return True;
        }
        if (rejected) {
            info("connection %y: the API key is not accepted by %y or by any other known "
                "deployment: %y", name, real_url, rejected);
        }
        return False;
    }

    private UnstructuredRestClient getImpl(bool connect = True, *hash<auto> rtopts) {
        return new UnstructuredRestClient(getConnectionOptions(rtopts), !connect);
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new UnstructuredRestClientIo(getConnectionOptions(rtopts));
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }

    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        hash<auto> rv = RestConnection::getConnectionOptions(rtopts);
        return UnstructuredRestClientBase::getOptions(rv);
    }
}
}

public namespace QoreRagUtils {
#! Unstructured.io-backed chunker
/** Posts text content to Unstructured.io for partitioning, then collapses
    the returned element tree into flat @ref ChunkInfo records.

    @par Configuration

    @ref ChunkerConfig fields:

    - \c strategy must be \c "unstructured"
    - \c target_tokens — soft cap per chunk (default 512); content
      grouping respects element boundaries first, then accumulates
      until the cap is reached
    - \c options.api_key (required) — Unstructured.io API key
    - \c options.url (optional) — override the default Unstructured URL
    - \c options.unstructured_options (optional) — passthrough hash of
      Unstructured-specific fields (`strategy`, `languages`, `coordinates`,
      `chunking_strategy`, etc.) sent on every request

    @par Element-tree flattening

    Each element in Unstructured's response has \c type (Title /
    NarrativeText / ListItem / Table / ...), \c text, and
    \c metadata.  Flattening rule: group consecutive elt_list under the
    most recent Title (or root if none yet); start a new chunk when the
    running token count would exceed \c target_tokens.  Each chunk's
    metadata carries the Title text (if any) under \c section and the
    list of constituent element types under \c element_types.
*/
public class UnstructuredChunker inherits AbstractChunker {
    public {
        #! Default Unstructured URL
        const DefaultUrl = UnstructuredRestClient::UnstructuredRestClientBase::DefaultUrl;
    }

    private {
        hash<ChunkerConfig> config;
        *UnstructuredRestClient::UnstructuredRestClientIo rest_client;
        Mutex init_mutex();
    }

    constructor(hash<ChunkerConfig> config) {
        self.config = config;
    }

    list<hash<ChunkInfo>> chunk(string content, *hash<auto> metadata) {
        if (!content.val()) {
            return ();
        }
        if (!config.options.api_key.val()) {
            throw "UNSTRUCTURED-CHUNKER-ERROR",
                "UnstructuredChunker requires 'options.api_key'";
        }
        ensureRestClient();
        list<hash<auto>> elt_list_list = rest_client.partitionText(content,
            config.options.unstructured_options ?? {});
        return flattenElements(elt_list_list, metadata);
    }

    string getStrategy() {
        return "unstructured";
    }

    #! Returns the underlying REST client
    *UnstructuredRestClient::UnstructuredRestClientIo getRestClient() {
        ensureRestClient();
        return rest_client;
    }

    #! Walks the Unstructured element tree into flat ChunkInfo records
    private list<hash<ChunkInfo>> flattenElements(list<hash<auto>> elt_list,
            *hash<auto> base_metadata) {
        int target = config.target_tokens > 0 ? config.target_tokens : 512;

        list<hash<ChunkInfo>> chunks = ();
        # State accumulator passed by reference to flushChunk()
        hash<auto> state;
        state.current_section = NOTHING;
        state.current_texts = ();
        state.current_types = ();
        state.current_tokens = 0;
        state.idx = 0;

        foreach hash<auto> el in (elt_list) {
            *string text = el.text;
            if (!text.val()) {
                continue;
            }
            string el_type = el."type" ?? "Element";

            # Title resets section + flushes accumulated content
            if (el_type == "Title") {
                flushChunk(\state, \chunks, base_metadata);
                state.current_section = text;
                # Don't include the Title itself in the chunk body — record
                # it as section metadata instead
                continue;
            }

            int t = approximateTokens(text);
            if (state.current_texts && state.current_tokens + t > target) {
                flushChunk(\state, \chunks, base_metadata);
            }
            push state.current_texts, text;
            push state.current_types, el_type;
            state.current_tokens += t;
        }
        flushChunk(\state, \chunks, base_metadata);
        return chunks;
    }

    private nothing flushChunk(reference<hash<auto>> state,
            reference<list<hash<ChunkInfo>>> chunks,
            *hash<auto> base_metadata) {
        if (!state.current_texts) {
            return;
        }
        *hash<auto> md = base_metadata;
        if (state.current_section.val()) {
            md = (md ?? {}) + {"section": state.current_section};
        }
        if (state.current_types) {
            md = (md ?? {}) + {"element_types": state.current_types};
        }
        push chunks, <ChunkInfo>{
            "index": state.idx,
            "content": (foldl $1 + "\n\n" + $2, state.current_texts),
            "token_count": state.current_tokens,
            "metadata": md,
        };
        ++state.idx;
        state.current_texts = ();
        state.current_types = ();
        state.current_tokens = 0;
    }

    private ensureRestClient() {
        if (rest_client) {
            return;
        }
        init_mutex.lock();
        on_exit init_mutex.unlock();
        if (rest_client) {
            return;
        }
        hash<auto!> opts = {
            "url": config.options.url ?? DefaultUrl,
            "apikey": config.options.api_key,
        };
        rest_client = new UnstructuredRestClient::UnstructuredRestClientIo(opts);
    }
}

#! Factory for @ref UnstructuredChunker
public class UnstructuredChunkerFactory inherits AbstractChunkerFactory {
    string getStrategy() {
        return "unstructured";
    }

    string getDisplayName() {
        return "Unstructured.io element-tree chunker";
    }

    AbstractChunker create(hash<ChunkerConfig> config) {
        return new UnstructuredChunker(config);
    }
}
}
